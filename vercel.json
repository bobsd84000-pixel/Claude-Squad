{
  "version": 2,
  "name": "claude-squad",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "nodejs",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "src/index.ts": {
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.js"
    }
  ]
}
